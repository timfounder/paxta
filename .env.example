# PAXTA — environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Application metadata.
VITE_APP_NAME=PAXTA
VITE_APP_VERSION=0.1.0

# Runtime environment: "development" | "staging" | "production".
VITE_APP_ENV=development

# Enable verbose in-game debug overlays and logging.
VITE_DEBUG=true

# Telegram bot username (without the @) used for deep links / share URLs.
VITE_TELEGRAM_BOT_USERNAME=

# Supabase — prepared for the persistence layer (not yet wired to a backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
